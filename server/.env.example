# LiveCode Server Environment Variables
# In production (Render/Cloud), set these in your hosting environment dashboard.

# Environment: "development" | "production" | "test"
NODE_ENV=development

# Server Port (Render sets this automatically to 10000)
PORT=5000

# PostgreSQL Database Connection URL (e.g., from Neon.tech, Render Postgres, or Supabase)
# For Neon: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/livecode?schema=public

# Frontend Application Origin URL
# Development: http://localhost:5173
# Production: https://your-app.vercel.app (NO trailing slash)
CLIENT_URL=http://localhost:5173

# Backend Server Origin URL (used for OAuth callbacks and WebSockets)
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com (NO trailing slash)
SERVER_URL=http://localhost:5000

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: ${SERVER_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Secrets (generate with: openssl rand -hex 64)
# Render Blueprint can also generate these automatically!
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_64_characters_recommended
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_64_characters_recommended

# Groq API Key for AI features (Llama 3.1 & Whisper audio transcription)
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# Code Execution Engine (Judge0 API)
# Default public CE endpoint: https://ce.judge0.com
# Or self-hosted: http://localhost:2358
JUDGE0_URL=https://ce.judge0.com

# OpenTelemetry Distributed Tracing (optional)
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=livecode-api
# OTEL_TRACES_EXPORTER=console