# LiveCode Client Environment Variables
# In production (Vercel), set these in your Project Settings -> Environment Variables.

# Backend API URL (NO trailing slash)
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Backend WebSocket URL (NO trailing slash)
# Development: http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Optional: TURN server for WebRTC NAT traversal
# Required for connections behind corporate firewalls / symmetric NATs
# Free providers: Metered.ca, Twilio, Xirsys, or self-hosted coturn
# VITE_TURN_URL=turn:your-turn-server.example.com:3478
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-credential